# LLM inference (free tier: https://console.groq.com)
GROQ_API_KEY=

# Fallback/variety inference (free tier: https://openrouter.ai). Optional — if set, agents
# automatically fall back to OpenRouter on a Groq rate-limit error (see src/model_config.py).
OPENROUTER_API_KEY=
# Optional override — OpenRouter's free-tier lineup rotates; check
# https://openrouter.ai/models?max_price=0 if the default in model_config.py stops working
OPENROUTER_FALLBACK_MODEL=

# Third fallback tier (free tier: https://aistudio.google.com/apikey). Optional — extends the
# fallback chain to Groq -> OpenRouter -> Gemini when both of the above are also exhausted.
GOOGLE_API_KEY=
# Optional override — verify current free-tier rate limits for whatever model this resolves to
# at https://ai.google.dev/gemini-api/docs/rate-limits before relying on the default
GEMINI_MODEL=

# Observability — optional, tracing no-ops if unset (free tier: https://langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
